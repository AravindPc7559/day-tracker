{
  "expo": {
    "name": "CaptureDay",
    "slug": "captureday",
    "scheme": "captureday",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Microphone access is needed for voice input.",
        "NSSpeechRecognitionUsageDescription": "Speech recognition converts your voice to text.",
        "NSCameraUsageDescription": "Camera access is needed to capture bills and receipts.",
        "NSPhotoLibraryUsageDescription": "Photo library access is needed to save captured images."
      }
    },
    "android": {
      "package": "com.aravind.captureday",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-secure-store",
      "expo-audio",
      "expo-web-browser",
      "expo-image-picker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2563EB",
          "defaultChannel": "default"
        }
      ],
      "./plugins/withAppComponentFactoryFix",
      "./plugins/withExcludeLegacySupportLibrary"
    ],
    "extra": {
      "eas": {
        "projectId": "7e87149c-9650-4209-9bf3-6c7a007e9862"
      }
    },
    "owner": "aravindpcexpo"
  }
}
