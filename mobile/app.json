{
  "expo": {
    "name": "Blurt",
    "slug": "blurt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Microphone access is needed for voice input.",
        "NSSpeechRecognitionUsageDescription": "Speech recognition converts your voice to text.",
        "NSCameraUsageDescription": "Camera access is needed to capture bills and receipts.",
        "NSPhotoLibraryUsageDescription": "Photo library access is needed to save captured images."
      }
    },
    "android": {
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-secure-store",
      "expo-audio",
      "expo-web-browser",
      "expo-image-picker"
    ]
  }
}
