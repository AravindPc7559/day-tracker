{
  "env": {
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run lint:fix)",
      "Bash(npm test)",
      "Bash(npm run test:*)",
      "Bash(npm run build)",
      "Bash(npm run typecheck)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx eslint *)",
      "Bash(cd mobile && npm run *)",
      "Bash(cd server && npm run *)"
    ],
    "deny": [
      "Bash(*/.env*)",
      "Bash(git push*)",
      "Bash(git push --force*)"
    ]
  }
}
